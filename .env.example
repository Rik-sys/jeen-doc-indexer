# Copy this file to .env and fill in the values. Never commit .env.

# Google AI Studio API key (https://aistudio.google.com -> Get API key)
GEMINI_API_KEY=

# Connection string used by the Python code
POSTGRES_URL=postgresql://jeen:jeen_local_dev@localhost:5432/doc_index

# Used by docker-compose.yml to create the local database (must match POSTGRES_URL)
POSTGRES_USER=jeen
POSTGRES_PASSWORD=jeen_local_dev
POSTGRES_DB=doc_index
POSTGRES_PORT=5432
